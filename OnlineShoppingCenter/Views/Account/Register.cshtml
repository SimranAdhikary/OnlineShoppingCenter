
@model OnlineShoppingCenter.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/Register.cshtml.css" />

<div class="register-container">
    <div class="register-card">
        <h2>Create Account</h2>
        <p class="register-subtitle">Join OnlineShoppingCenter today</p>

        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="name-row">
                <div class="form-group">
                    <label asp-for="FirstName">First Name</label>
                    <input asp-for="FirstName"
                           class="form-control"
                           placeholder="Enter first name" />
                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">Last Name</label>
                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="Enter last name" />
                    <span asp-validation-for="LastName"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">Contact Number</label>
                <input asp-for="PhoneNumber"
                       class="form-control"
                       placeholder="Enter contact number" />
                <span asp-validation-for="PhoneNumber"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="Enter email address" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Create password" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control"
                       placeholder="Confirm password" />
                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="register-btn">
                Create Account
            </button>

            <p class="signin-text">
                Already have an account?
                <b><a asp-controller="Account"
                   asp-action="SignIn">Sign In</a></b>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
